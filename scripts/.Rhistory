source("~/Documents/GitHub/clara_gimenez_bitacora/scripts/ejercicios_transito_aire.R")
source("~/Documents/GitHub/clara_gimenez_bitacora/scripts/analisis_transito_aire.R")
g9_pm25 <- ggplot(por_franja, aes(franja, pm25)) +
geom_col(fill = COL_PM25) +
geom_hline(yintercept = 1, color = "grey40", linetype = "dashed") +
facet_wrap(~ estacion) +
labs(title = "PM2.5 promedio por franja horaria",
x = NULL, y = "PM2.5 (µg/m³)")
print(g9_pm25)
g9 <- ggplot(por_franja, aes(franja, transito_rel)) +
geom_col(fill = COL_PM25) +
geom_hline(yintercept = 1, color = "grey40", linetype = "dashed") +
facet_wrap(~ estacion) +
labs(title = "pm25 por franja horaria, relativo a la media de la estación",
x = NULL, y = "Tránsito relativo (1 = media de la estación)")
print(g9)
